__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.DS_Store
.claude/
.pytest_cache/
.ipynb_checkpoints/

# raw/processed dataset files -- large, re-derivable from source; see each
# dataset folder's README for how to re-pull it
mtg-card-prices/raw/*.parquet
mtg-card-prices/processed/
mtg-card-market-dataset/*.parquet

# training data/checkpoints -- local only, regenerated by the scripts (see
# training/README.md); the best models are published to HF instead
# (scripts/export_models.py -> models/ -> scripts/push_models_to_hub.py)
training/*.parquet
training/*.cbm
training/*.json
training/*.npy
training/*.pt
training/tune_candidates/
training/ablation_checkpoints/
training/robustness_checkpoints/
training/inducing_sweep/
training/best_tactics/
training/collapse_fixes/
training/tune_candidates_quantile/
training/ablation_checkpoints_quantile/
models/
catboost_info/

# card art -- large (~3GB), fully re-derivable via scripts/fetch_card_art.py
# (see card_art/README.md)
card_art/images/
card_art/*.jsonl.gz
card_art/*.parquet

# embeddings -- large, fully re-derivable (see embeddings/README.md)
embeddings/*.parquet

*.local.json

# separate repo, tracked on its own -- don't let it get swept into this one
mtg-print-distribution/

